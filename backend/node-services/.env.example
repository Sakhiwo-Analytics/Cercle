# Server Configuration
PORT=8000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_DB_PASSWORD=your-database-password

# Note: Supabase Auth is used for authentication
# No additional configuration is needed as it uses the same Supabase credentials



# Redis Configuration
REDIS_URL=redis://redis:6379

# Note: Supabase Storage is used for file storage instead of AWS S3
# Make sure to create a 'files' bucket in your Supabase project
# and set appropriate permissions in the Storage section of the Supabase dashboard

# Sentry Configuration
SENTRY_DSN=your-sentry-dsn
