# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Server Configuration
PORT=8001
ENVIRONMENT=development

# Redis Configuration
REDIS_URL=redis://redis:6379

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORGANIZATION=your-openai-org-id

# Anthropic (Claude) Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key

# Wolfram Alpha Configuration
WOLFRAM_APP_ID=your-wolfram-app-id

# Pinecone Configuration
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=cercle-vector-index

# PDF Processing Configuration
PYTESSERACT_PATH=/usr/bin/tesseract  # Path to tesseract executable

# LangChain Configuration
LANGCHAIN_TRACING_V2=false  # Set to true to enable LangChain tracing
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_PROJECT=cercle
